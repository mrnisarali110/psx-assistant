// Cloudflare Workers static assets (the successor to Pages). No server code: the built app only.
// Static asset requests are free and unlimited on the Workers Free plan (checked 2026-10-06).
// Deploy: npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psx-assistant",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Routes are hash-based (/#/plan), so no SPA fallback: a missing file must be a real 404,
    // never index.html served under an immutable /assets/ URL.
    "not_found_handling": "none"
  }
}
