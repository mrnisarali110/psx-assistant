// Cloudflare Workers: the built app (static assets, free and unlimited) plus a tiny API for
// screenshot import (edge/index.ts). Deploy: npm run deploy
// Secrets (set once, never in the repo): npx wrangler secret put OPENROUTER_API_KEY / GEMINI_API_KEY / GROQ_API_KEY
// GET /api/ai-status shows which of them are ready (free checks, no AI tokens).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psx-assistant",
  "main": "edge/index.ts",
  "compatibility_date": "2026-10-01",
  // Workers Logs (free): import errors are logged here, never the screenshots.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker; every other request is a plain static file.
    "run_worker_first": ["/api/*"],
    // Routes are hash-based (/#/home), so no SPA fallback: a missing file must be a real 404.
    "not_found_handling": "none"
  },
  "vars": {
    "SUPABASE_URL": "https://tqggelxnrymytxmxftqn.supabase.co",
    "SUPABASE_KEY": "sb_publishable_EZv38dgY1VfUVKEi16Ybag_Khi-6OMV"
  }
}
