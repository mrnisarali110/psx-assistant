{
  "name": "psx-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PSX personal investing assistant: PWA + scheduled worker. Advice only, never trades.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx -y wrangler@4 deploy",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "worker": "tsx worker/run.ts",
    "icons": "tsx scripts/make-icons.ts",
    "vapid": "tsx scripts/make-vapid.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cheerio": "^1.2.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
